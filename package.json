{
  "name": "@devkitvault/recall",
  "version": "1.2.8",
  "description": "recall CLI — personal command vault for your terminal",
  "keywords": [
    "cli",
    "shell",
    "commands",
    "devtools",
    "recall",
    "vault",
    "sync",
    "kubernetes",
    "docker",
    "terminal",
    "devkitvault"
  ],
  "author": "devkitvault",
  "license": "MIT",
  "homepage": "https://recall.devkitvault.com",
  "bugs": {
    "url": "https://github.com/devkitvault/recall-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devkitvault/recall-cli.git"
  },
  "bin": {
    "recall": "dist/index.js",
    "rec": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --require ts-node/register --test src/lib/project.test.ts src/lib/turns.test.ts src/lib/tags.test.ts src/lib/source-label.test.ts src/lib/shell-history.test.ts",
    "prepublishOnly": "node scripts/prepublish.cjs && node --check dist/index.js",
    "check:registry": "npm view @devkitvault/recall version",
    "try:published": "npx --yes --package=@devkitvault/recall@latest recall --version"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.3",
    "commander": "^12.0.0",
    "inquirer": "^8.2.7",
    "open": "^8.4.2",
    "ora": "^5.4.1"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@types/inquirer": "^8.2.12",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.9.0"
  }
}
